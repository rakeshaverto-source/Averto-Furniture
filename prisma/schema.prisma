// Averto store database. Money is stored in whole rupees (Int), matching the rest of the app.
// Tables are mapped to snake_case names so they read naturally in the Supabase dashboard.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Catalogue ──────────────────────────────────────────────────────────────

model Category {
  id        String    @id // slug used in URLs, e.g. "sofas"
  name      String
  blurb     String
  sortOrder Int       @default(0)
  products  Product[]

  @@map("categories")
}

model Product {
  id               String   @id // slug used in URLs and saved carts, e.g. "monolith-slate-table"
  name             String
  categoryId       String
  badge            String
  description      String
  specs            String
  priceInr         Int // price the customer pays for the default colour
  originalPriceInr Int? // crossed-out price; a colour's priceDelta applies to both
  zoomClass        String? // optional crop for photos with a white frame baked in
  isActive         Boolean  @default(true) // hide a product without deleting it
  // Search-engine overrides set in the admin SEO panel; empty means use the name / description
  seoTitle         String?
  seoDescription   String?
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category   Category       @relation(fields: [categoryId], references: [id])
  colors     ProductColor[]
  images     ProductImage[]
  reviews    Review[]
  wishlist   WishlistItem[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@map("products")
}

model ProductColor {
  id         String @id @default(cuid())
  productId  String
  slug       String // e.g. "smoked-oak"; saved carts refer to a colour by this
  name       String
  hex        String
  priceDelta Int    @default(0) // added to the product price when chosen
  sortOrder  Int    @default(0) // the first colour is the default

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  images  ProductImage[]

  @@unique([productId, slug])
  @@map("product_colors")
}

enum ImageFit {
  cover
  contain // keeps white-background studio shots uncropped
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  colorId   String? // set when the photo belongs to one colour
  // Either a path inside the Supabase "products" bucket ("oak-table/main.webp")
  // or, for the current sample photos, a file in /public ("/hero/dining-table.jpg").
  path      String
  label     String   @default("") // alt text / thumbnail caption
  fit       ImageFit @default(cover)
  sortOrder Int      @default(0) // the lowest one without a colour is the main photo

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  color   ProductColor? @relation(fields: [colorId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// ─── Reviews ────────────────────────────────────────────────────────────────

enum ReviewStatus {
  pending
  approved
  rejected
}

model Review {
  id        String       @id @default(cuid())
  productId String
  name      String
  location  String
  email     String? // never shown on the site
  rating    Int // 1-5
  title     String
  text      String
  status    ReviewStatus @default(pending) // only approved reviews are shown
  // Invented preview reviews from src/data/reviews.ts. Delete them before launch:
  //   delete from reviews where "isSample";
  isSample  Boolean      @default(false)
  userId    String? // the account that wrote it, when written from "My account"
  verified  Boolean      @default(false) // the writer bought and received this product
  createdAt DateTime     @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId]) // one review per customer per product
  @@index([productId, status])
  @@map("reviews")
}

// ─── Coupons ────────────────────────────────────────────────────────────────

enum CouponType {
  percent
  flat
}

model Coupon {
  code               String     @id // stored upper case
  description        String
  type               CouponType
  value              Int // percent (e.g. 10) or rupees off
  minOrder           Int? // order subtotal needed, in rupees
  maxDiscount        Int? // cap for percent coupons, in rupees
  // Personal coupon: only these customer emails (lower case) may use it. Empty = anyone.
  // Never sent to the browser.
  allowedEmails      String[]   @default([])
  maxUses            Int? // total uses across all customers; empty = unlimited
  maxUsesPerCustomer Int? // uses per customer email, e.g. 1 = once each; empty = unlimited
  isActive           Boolean    @default(true)
  expiresAt          DateTime?
  createdAt          DateTime   @default(now())

  @@map("coupons")
}

// ─── Orders ─────────────────────────────────────────────────────────────────

// Where the online advance stands
enum OrderStatus {
  received // no payment gateway configured, the team follows up
  awaiting_payment
  deposit_paid
}

// Where the piece itself stands, updated by the team in /admin/orders
enum FulfillmentStatus {
  new
  confirmed
  in_production
  shipped
  out_for_delivery
  delivered
  cancelled
}

// How the customer chose to pay at checkout; each one sets how much of the total is paid online first
enum PaymentMethod {
  full // the whole amount online
  advance // the usual advance online, the balance later
  cod // a small advance online, the rest in cash on delivery
}

model Order {
  id     String      @id @default(cuid())
  ref    String      @unique // order number shown to the customer
  status OrderStatus
  userId String? // Supabase Auth user who placed it (empty for orders from before login was required)

  // Customer details as entered at checkout (guest checkout, no accounts yet)
  customerName  String
  customerPhone String
  customerEmail String
  address       String
  locality      String @default("") // area / post office, picked from the pincode
  landmark      String @default("")
  city          String
  tehsil        String @default("")
  state         String
  pincode       String
  notes         String @default("")

  subtotal       Int
  couponCode     String? // copied, not linked, so deleting a coupon keeps old orders intact
  discount       Int           @default(0)
  total          Int
  deposit        Int
  depositPercent Int
  paymentMethod  PaymentMethod @default(advance)

  razorpayOrderId          String?   @unique
  razorpayPaymentId        String?
  paidAt                   DateTime?
  // The balance, when the customer pays it online from "My account"
  balanceRazorpayOrderId   String?   @unique
  balanceRazorpayPaymentId String?

  fulfillment   FulfillmentStatus @default(new)
  balancePaid   Boolean           @default(false) // the rest after the advance, usually settled offline
  balancePaidAt DateTime?
  adminNote     String            @default("") // for the team only, never shown to the customer

  // Delivery details filled in by the team and shown to the customer
  expectedDelivery DateTime? @db.Date
  courierName      String    @default("")
  trackingNumber   String    @default("")
  trackingUrl      String    @default("")
  // When our own team delivers: who is bringing it, and the time window agreed with the customer.
  // The name, phone and vehicle are copied from the driver, so the order keeps them if the driver leaves.
  driverId         String?
  driverName       String    @default("")
  driverPhone      String    @default("")
  vehicleNumber    String    @default("")
  deliverySlot     String    @default("") // e.g. "10am – 1pm"
  // Only the driver app's latest position, kept while the order is out for delivery and cleared after
  driverLat        Float?
  driverLng        Float?
  driverLocationAt DateTime?

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  driver    Driver?      @relation(fields: [driverId], references: [id], onDelete: SetNull)
  items     OrderItem[]
  events    OrderEvent[]

  @@index([createdAt])
  @@index([fulfillment])
  @@index([userId])
  @@index([couponCode])
  @@index([driverId])
  @@map("orders")
}

// Our own delivery staff, who sign in to the driver app with their phone number and a PIN
model Driver {
  id            String    @id @default(cuid())
  name          String
  phone         String    @unique // 10 digits, no country code
  pinHash       String // scrypt "salt:hash", never the PIN itself
  vehicleNumber String    @default("")
  isActive      Boolean   @default(true)
  failedLogins  Int       @default(0)
  lockedUntil   DateTime? // set after too many wrong PINs
  createdAt     DateTime  @default(now())

  sessions DriverSession[]
  orders   Order[]

  @@map("drivers")
}

// One signed-in phone. The app keeps the token; only its hash is stored here.
model DriverSession {
  id         String   @id @default(cuid())
  driverId   String
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@map("driver_sessions")
}

// Each status change made by the team, so the order shows when every step happened
model OrderEvent {
  id          String            @id @default(cuid())
  orderId     String
  fulfillment FulfillmentStatus
  createdAt   DateTime          @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_events")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String? // kept for reports; cleared if the product is ever deleted
  // Snapshot of what was bought, so later price or name changes don't rewrite history
  name      String
  colorSlug String?
  colorName String?
  qty       Int
  unitPrice Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

// ─── Customer accounts ──────────────────────────────────────────────────────
// Customers are Supabase Auth users; userId is their auth id.

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String   @default("") // e.g. Home, Office
  name      String
  phone     String
  address   String
  locality  String   @default("") // area / post office, picked from the pincode
  landmark  String   @default("")
  city      String
  tehsil    String   @default("")
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("addresses")
}

// ─── Admin team ─────────────────────────────────────────────────────────────
// Emails in ADMIN_EMAILS are always owners. Everyone else gets admin access only through a row
// here, and sees just the sections of their role (src/lib/admin-auth.ts).

enum StaffRole {
  owner
  seo
  orders
  content
  blog
}

model StaffMember {
  email     String    @id // lower-case; they sign in at /admin/login with this account
  role      StaffRole
  addedBy   String
  createdAt DateTime  @default(now())

  @@map("staff_members")
}

// ─── SEO ────────────────────────────────────────────────────────────────────

// Site-wide search settings: a single row with id "site"
model SeoSettings {
  id                 String   @id @default("site")
  siteName           String   @default("Averto")
  defaultTitle       String   @default("")
  defaultDescription String   @default("")
  ogImage            String? // shown when a page is shared; a bucket path or /public file
  googleVerification String   @default("") // Search Console HTML-tag code
  bingVerification   String   @default("")
  updatedAt          DateTime @updatedAt

  @@map("seo_settings")
}

// Title and description for a fixed page of the shop, e.g. "/" or "/collections"
model PageSeo {
  path        String   @id
  title       String   @default("")
  description String   @default("")
  ogImage     String?
  noindex     Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@map("page_seo")
}

// ─── Blog ───────────────────────────────────────────────────────────────────

enum PostStatus {
  draft
  published
}

model BlogPost {
  id             String     @id @default(cuid())
  slug           String     @unique
  title          String
  excerpt        String     @default("") // shown on the blog list and as the fallback description
  content        Json // Tiptap document, rendered by src/components/blog/PostContent.tsx
  coverImage     String? // bucket path
  coverAlt       String     @default("")
  tags           String[]
  productIds     String[] // related products shown under the post
  status         PostStatus @default(draft)
  publishedAt    DateTime?
  authorName     String
  authorEmail    String // the admin who created it
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status, publishedAt])
  @@map("blog_posts")
}
